{
  // 说明：渲染层（overlay / panel）编译配置。
  // 渲染层是原生 TS + DOM，无 UI 框架（架构 D1），产物为 classic script（不含 import/export），
  // 因此可以直接被 file:// 加载的 HTML 以 <script src> 方式引用，无需打包器。
  // 关键约束：渲染层只允许 `import type`（编译期擦除）；跨文件的**值**必须挂到 window 全局，
  // 否则会编译出 ESM import 语句，在 file:// 下无法加载。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist-renderer",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": true
  },
  //注意：必须显式列出 globals.d.ts。include 的 `src/renderer/**/*.ts` 虽然
  // 能匹配到 .d.ts（*.ts 通配包含 .d.ts），但 tsc 对 "include 命中 + 同时被
  // import 引用" 的 .d.ts 处理会跳过其 declare global 块，导致渲染层拿不到
  // AiSnapshot / AiTaskStatus 等别名（表现为 "Cannot find name 'AiSnapshot'"）。
  // 显式列出后 ambient 声明必然生效，是最稳的写法。
  "include": ["src/renderer/**/*.ts", "src/renderer/globals.d.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
