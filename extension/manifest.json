{
  "manifest_version": 3,
  "name": "AI 任务指示灯 · 标签切换桥",
  "version": "1.1.1",
  "description": "让本地「AI 任务状态指示灯」把已打开的页面标签切到前台，而不是重复新开标签。",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
